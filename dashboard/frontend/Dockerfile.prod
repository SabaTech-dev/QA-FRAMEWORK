# syntax=docker/dockerfile:1
# Prod-grade frontend image (card 4a2dbdca): multi-stage build -> nginx alpine.
# Replaces the Vite DEV server for qa.sabatech.dev.
# Build:  docker build -f dashboard/frontend/Dockerfile.prod --build-arg VITE_API_URL=/api dashboard/frontend

# ---- Stage 1: build ----
FROM node:26-alpine AS build
WORKDIR /app

COPY package*.json ./
# npm 12: install-scripts allowlist enforced (same policy as dev Dockerfile)
RUN npm ci --legacy-peer-deps

COPY . .
# VITE_API_URL: relative by default so nginx proxies /api to the backend container
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# ---- Stage 2: serve ----
FROM nginxinc/nginx-unprivileged:1.27-alpine
USER 101
COPY --from=build --chown=101:101 /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
